{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/landing-preview", "destination": "/index.html" },
    { "source": "/operator", "destination": "/index.html" },
    { "source": "/prototype/ticket", "destination": "/index.html" },
    { "source": "/track", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/services/:id", "destination": "/index.html" },
    { "source": "/pos", "destination": "/index.html" },
    { "source": "/customers", "destination": "/index.html" },
    { "source": "/inventory", "destination": "/index.html" },
    { "source": "/suppliers", "destination": "/index.html" },
    { "source": "/finance", "destination": "/index.html" },
    { "source": "/tasks", "destination": "/index.html" },
    { "source": "/attendance", "destination": "/index.html" },
    { "source": "/reports", "destination": "/index.html" },
    { "source": "/activity", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://fixmaster.app/index.md>; rel=\"alternate\"; type=\"text/markdown\", <https://fixmaster.app/pricing.md>; rel=\"describedby\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.fixmaster.my.id wss://api.fixmaster.my.id https://*.supabase.co wss://*.supabase.co https://*.sentry.io https://*.ingest.sentry.io; manifest-src 'self'; worker-src 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    }
  ]
}
