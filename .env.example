# FixMaster — Environment Variables
# Copy this file to `.env.local` and fill in your Supabase project values.
# WITHOUT these, the app runs in local-first mode (IndexedDB, offline).
# WITH them, the app uses Supabase (Postgres + RLS + Auth) for production.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for the browser — RLS enforces access).
VITE_SUPABASE_ANON_KEY=

# OPTIONAL — Remote error tracking (Sentry). Leave empty to disable:
# without a DSN the Sentry SDK is never loaded (no bundle/network cost) and
# errors stay console-only. Get a DSN at https://sentry.io → Project Settings.
VITE_SENTRY_DSN=

# Public URL of the GoPay merchant QR image. This is the ONLY real payment
# path for subscriptions (the hosted gateways were removed) — see
# docs/gopay-listener-android.md. Leaving it empty degrades billing to mock
# invoices that an owner confirms by hand, which is fine for local/dev but
# means production collects nothing.
VITE_GOPAY_QRIS_URL=
